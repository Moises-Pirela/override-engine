#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_ecs = env_modules.Clone()

module_obj = []
env_ecs.add_source_files(module_obj, "*.cpp")
env_ecs.add_source_files(module_obj, "core/*.cpp")
env_ecs.add_source_files(module_obj, "net/*.cpp")
env_ecs.add_source_files(module_obj, "bindings/*.cpp")
env_ecs.add_source_files(module_obj, "components/*.cpp")
env_ecs.add_source_files(module_obj, "resources/*.cpp")

if env.editor_build:
    env_ecs.add_source_files(module_obj, "editor/*.cpp")

env.modules_sources += module_obj

if env["tests"]:
    env_ecs.Append(CPPDEFINES=["TESTS_ENABLED"])
    env_ecs.add_source_files(env.modules_sources, "./tests/*.cpp")

    if env["disable_exceptions"]:
        env_ecs.Append(CPPDEFINES=["DOCTEST_CONFIG_NO_EXCEPTIONS_BUT_WITH_ALL_ASSERTS"])
